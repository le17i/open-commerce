generator client {
  provider      = "prisma-client"
  output        = "../src/database/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id                Int                 @id @default(autoincrement())
  createAt          DateTime            @default(now())
  slug              String              @unique
  code              String              @unique
  title             String
  description       String?

  products          Product[]

  parentId          Int?                @unique
  parent            Category?           @relation("CategoryParent", fields: [parentId], references: [id])
  children          Category?           @relation("CategoryParent")
}

model Brand {
  id                Int                 @id @default(autoincrement())
  createAt          DateTime            @default(now())
  slug              String              @unique
  code              String              @unique
  title             String
  description       String?

  products          Product[]
}

model Color {
  id                Int                 @id @default(autoincrement())
  createAt          DateTime            @default(now())
  slug              String              @unique
  code              String              @unique
  colorHex          String
  title             String
  description       String?

  products          Product[]
}

model Tag {
  id                Int                 @id @default(autoincrement())
  createAt          DateTime            @default(now())
  label             String
  slug              String              @unique
  products          Product[]
}

model Product {
  id                Int                 @id @default(autoincrement())
  createAt          DateTime            @default(now())
  slug              String              @unique
  barcode           String              @unique
  sku               String
  model             String
  title             String
  description       String?
  content           String?
  stock             Int                 @default(0)
  height            Int                 @default(0)
  length            Int                 @default(0)
  weight            Float               @default(0)
  width             Int                 @default(0)
  status            ProductStatusEnum   @default(DRAFT)
  images            Image[]
  offers            Offer[]
  tags              Tag[]

  parentId          Int?
  parent            Product?            @relation("ProductVariant", fields: [parentId], references: [id])
  variants          Product[]           @relation("ProductVariant")

  brand             Brand               @relation(fields: [brandId], references: [id])
  brandId           Int

  category          Category            @relation(fields: [categoryId], references: [id])
  categoryId        Int

  color             Color               @relation(fields: [colorId], references: [id])
  colorId           Int

  kind              Kind                @relation(fields: [kindId], references: [id])
  kindId            Int
}

model Kind {
  id                Int                 @id @default(autoincrement())
  createAt          DateTime            @default(now())
  code              String              @unique
  label             String              @unique
  products          Product[]
}

model Image {
  id                Int                 @id @default(autoincrement())
  createAt          DateTime            @default(now())
  filename          String
  ext               String?
  description       String?
  product           Product             @relation(fields: [productId], references: [id])
  productId         Int
}

model Offer {
  id                Int                 @id @default(autoincrement())
  createAt          DateTime            @default(now())
  price             Int                 @default(0)
  promotionalPrice  Int                 @default(0)
  discount          Int                 @default(0)
  paymentMethods    OfferPaymentMethod[]
  isActive          Boolean             @default(false)
  product           Product             @relation(fields: [productId], references: [id])
  productId         Int
}

enum ProductStatusEnum {
  DRAFT
  PUBLISHED
  OUTDATE
}

enum OfferPaymentMethod {
  CREDIT_CARD
  PIX
}
